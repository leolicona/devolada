{
  "$schema": "../api/node_modules/wrangler/config-schema.json",
  "name": "devolada-admin",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {
      "name": "devolada-admin-dev",
      "routes": [{ "pattern": "app.dev.devoladapago.com", "custom_domain": true }]
    },
    "prod": {
      "name": "devolada-admin",
      "routes": [{ "pattern": "app.devoladapago.com", "custom_domain": true }]
    }
  }
}
