{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devolada-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devolada-db",
      "database_id": "devolada-db-local",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_BASE_URL": "https://agnostic-auth.leolicona-dev.workers.dev",
    "AUTH_APP_ID": "devolada",
    "ENVIRONMENT": "dev"
  },
  /* Remote environments (CICD.md). Per-environment secrets via
     `wrangler secret put --env`: AUTH_JWT_SECRET (required in prod). */
  "env": {
    "dev": {
      "name": "devolada-api-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-dev",
          "database_id": "b1b5bace-f440-488b-99a4-4339570b1360",
          "migrations_dir": "migrations"
        }
      ],
      "services": [{ "binding": "AGNOSTIC_AUTH_API", "service": "agnostic-auth" }],
      "vars": {
        "AUTH_BASE_URL": "https://agnostic-auth.leolicona-dev.workers.dev",
        "AUTH_APP_ID": "devolada",
        "ENVIRONMENT": "dev"
      }
    },
    "prod": {
      "name": "devolada-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-prod",
          "database_id": "706a3cfb-00a0-4aba-87d6-50d059c562d5",
          "migrations_dir": "migrations"
        }
      ],
      "services": [{ "binding": "AGNOSTIC_AUTH_API", "service": "agnostic-auth" }],
      "vars": {
        "AUTH_BASE_URL": "https://agnostic-auth.leolicona-dev.workers.dev",
        "AUTH_APP_ID": "devolada",
        "ENVIRONMENT": "prod"
      }
    }
  }
}
