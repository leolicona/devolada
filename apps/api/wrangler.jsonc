{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devolada-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devolada-db",
      "database_id": "devolada-db-local",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "API_BASE_URL": "http://localhost:8787",
    "ADMIN_BASE_URL": "http://localhost:5174",
    "TIENDA_BASE_URL": "http://localhost:5173",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174",
    /* Not a secret. Repeated in every env block below because an env's
       `vars` replaces the top-level one rather than merging with it. */
    "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
  },
  /* Remote environments (CICD.md). Per-environment secrets set by CI
     after deploy: BETTER_AUTH_SECRET (required — auth cannot run without
     it), RESEND_API_KEY. */
  "env": {
    "dev": {
      "name": "devolada-api-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-dev",
          "database_id": "b1b5bace-f440-488b-99a4-4339570b1360",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "API_BASE_URL": "https://devolada-api-dev.leolicona-dev.workers.dev",
        "ADMIN_BASE_URL": "https://devolada-admin-dev.leolicona-dev.workers.dev",
        "TIENDA_BASE_URL": "https://devolada-tienda-dev.leolicona-dev.workers.dev",
        "ALLOWED_ORIGINS": "https://devolada-tienda-dev.leolicona-dev.workers.dev,*-devolada-tienda-dev.leolicona-dev.workers.dev,https://devolada-admin-dev.leolicona-dev.workers.dev,*-devolada-admin-dev.leolicona-dev.workers.dev",
        "CROSS_SITE_COOKIES": "true",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
      }
    },
    "prod": {
      "name": "devolada-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-prod",
          "database_id": "706a3cfb-00a0-4aba-87d6-50d059c562d5",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "API_BASE_URL": "https://devolada-api.leolicona-dev.workers.dev",
        "ADMIN_BASE_URL": "https://devolada-admin.leolicona-dev.workers.dev",
        "TIENDA_BASE_URL": "https://devolada-tienda.leolicona-dev.workers.dev",
        "ALLOWED_ORIGINS": "https://devolada-tienda.leolicona-dev.workers.dev,https://devolada-admin.leolicona-dev.workers.dev",
        "CROSS_SITE_COOKIES": "true",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
      }
    }
  }
}
