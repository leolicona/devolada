{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devolada-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  /* Better Auth's bundle imports node:crypto. The spike ran without this
     flag, but only because vitest-pool-workers resolves node builtins
     itself; wrangler's own bundling does not. Inherited by every env. */
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devolada-db",
      "database_id": "devolada-db-local",
      "migrations_dir": "migrations"
    }
  ],
  /* SPEI transfer proofs (direct-payment spec D12). Private: no public
     bucket URL — the API serves objects through signed URLs only. The
     15-day lifecycle rule is bucket config, applied once per env:
     `wrangler r2 bucket lifecycle add <bucket> --expire-days 15` */
  "r2_buckets": [
    { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs" }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "API_BASE_URL": "http://localhost:8787",
    "ADMIN_BASE_URL": "http://localhost:5174",
    "TIENDA_BASE_URL": "http://localhost:5173",
    "PAGO_BASE_URL": "http://localhost:5175",
    /* Local Consta (its own wrangler dev). CONSTA_API_KEY lives in
       .dev.vars, like every secret. */
    "CONSTA_BASE_URL": "http://localhost:8788",
    /* TD-015, temporary. Payment-link tokens whose validation is
       simulated instead of asked of Banxico (src/direct-payments/demo.ts).
       Empty = off, which is how it must stay unless a demo is happening.
       Read only when ENVIRONMENT is dev; the prod block below has no
       such var, on purpose. */
    "DEMO_LINK_TOKENS": "",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175",
    /* Not a secret. Repeated in every env block below because an env's
       `vars` replaces the top-level one rather than merging with it. */
    "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
  },
  /* Remote environments (CICD.md). Per-environment secrets set by CI
     after deploy: BETTER_AUTH_SECRET (required — auth cannot run without
     it), RESEND_API_KEY. */
  "env": {
    "dev": {
      "name": "devolada-api-dev",
      "routes": [{ "pattern": "api.dev.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-dev",
          "database_id": "b1b5bace-f440-488b-99a4-4339570b1360",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs-dev" }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "API_BASE_URL": "https://api.dev.devoladapago.com",
        "ADMIN_BASE_URL": "https://admin.dev.devoladapago.com",
        "TIENDA_BASE_URL": "https://punto.dev.devoladapago.com",
        "PAGO_BASE_URL": "https://pago.dev.devoladapago.com",
        "CONSTA_BASE_URL": "https://consta.dev.devoladapago.com",
        /* TD-015, temporary — the demo links, deleted after 2026-08-20.
           Tokens are permanent (D1), so baking them into the deploy is
           safe. testISP (leolicona.dev@gmail.com), which is the only ISP
           on dev with SPEI configured:
             vyzwrf2tnwwwn3xw  0011@wifiplus  Leo Licona  $3, SUSPENDIDO
             96u9as4gmnjuee5d  0012@wifiplus  Juana Soto  $2, SUSPENDIDO
             b6gvm4r77mix983b  0014@wifiplus  Daniel      $3, SUSPENDIDO
             7k4d8mwiqmck9ssj  0013@wifiplus  Ismael      suspended, owes nothing yet
             6cf4qb7ea26uqvmy  0001@wifiplus      spare
             a7zmaqwja7k3t9ge  arellano@wifiplus  spare
             fwpuqffbksnbkmpi  greyes@wifiplus    spare
             twvh4siym4bsm4sm  jacruz@wifiplus    spare
             wep8umyj2bqtn3sg  valeperez@wifiplus spare
             h5hjatrqddeu8k6w  acaballero@wifiplus spare
           The first two are the demo: both suspended, both owing, and
           0011's invoice sits in the "Router Test Demo" zone, which is
           the CHR lab router, so paying it reconnects real hardware.
           The spares owe nothing right now: a listed link with no debt
           never reaches the pay step at all, so they cost nothing and
           they mean a new invoice in WispHub is enough to add a demo
           customer — no second deploy in front of an audience.
           The ISP's other 8 links stay off the list on purpose: a listed
           link is never sent to the provider, so those are the only ones
           that can still validate a real transfer. */
        "DEMO_LINK_TOKENS": "vyzwrf2tnwwwn3xw,96u9as4gmnjuee5d,b6gvm4r77mix983b,7k4d8mwiqmck9ssj,6cf4qb7ea26uqvmy,a7zmaqwja7k3t9ge,fwpuqffbksnbkmpi,twvh4siym4bsm4sm,wep8umyj2bqtn3sg,h5hjatrqddeu8k6w",
        "ALLOWED_ORIGINS": "https://punto.dev.devoladapago.com,https://admin.dev.devoladapago.com,https://pago.dev.devoladapago.com,*-devolada-tienda-dev.leolicona-dev.workers.dev,*-devolada-admin-dev.leolicona-dev.workers.dev,*-devolada-pago-dev.leolicona-dev.workers.dev",
        "PASSKEY_RP_ID": "dev.devoladapago.com",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
      }
    },
    "prod": {
      "name": "devolada-api",
      "routes": [{ "pattern": "api.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-prod",
          "database_id": "706a3cfb-00a0-4aba-87d6-50d059c562d5",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs" }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "API_BASE_URL": "https://api.devoladapago.com",
        "ADMIN_BASE_URL": "https://admin.devoladapago.com",
        "TIENDA_BASE_URL": "https://punto.devoladapago.com",
        "PAGO_BASE_URL": "https://pago.devoladapago.com",
        /* No CONSTA_BASE_URL: Consta has no prod env yet (its spec D8).
           Without it the SPEI channel answers "unavailable" — customers
           are pointed at the store network instead of a void. */
        "ALLOWED_ORIGINS": "https://punto.devoladapago.com,https://admin.devoladapago.com,https://pago.devoladapago.com",
        "PASSKEY_RP_ID": "devoladapago.com",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
      }
    }
  }
}
