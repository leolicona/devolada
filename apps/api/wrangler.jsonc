{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devolada-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  /* Better Auth's bundle imports node:crypto. The spike ran without this
     flag, but only because vitest-pool-workers resolves node builtins
     itself; wrangler's own bundling does not. Inherited by every env. */
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devolada-db",
      "database_id": "devolada-db-local",
      "migrations_dir": "migrations"
    }
  ],
  /* SPEI transfer proofs (direct-payment spec D12). Private: no public
     bucket URL — the API serves objects through signed URLs only. The
     15-day lifecycle rule is bucket config, applied once per env:
     `wrangler r2 bucket lifecycle add <bucket> --name expire-15d --expire-days 15` */
  "r2_buckets": [
    { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs" }
  ],
  /* proof-extraction D5: the receipt reader runs on Workers AI. The
     models are vars, never literals in code (constitution VIII):
     `EXTRACTION_MODEL` is the default, and `EXTRACTION_MODELS` is the
     list the operator picks from in /operador → Lector — the pick is a
     row, the list is a deploy (receipt-reader-tuning D1, D7). Like
     `d1_databases`, an env block replaces this rather than inheriting it,
     so both are repeated below (consta-api-merge D9). */
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "dev",
    "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "EXTRACTION_MODELS": [
      { "id": "@cf/mistralai/mistral-small-3.1-24b-instruct", "label": "Mistral Small 3.1" },
      /* receipt-reader-tuning D10: thinking off — the reader wants the
         JSON, not the reasoning (research R5) */
      { "id": "@cf/google/gemma-4-26b-a4b-it", "label": "Gemma 4 26B", "input": { "chat_template_kwargs": { "enable_thinking": false } } }
    ],
    "API_BASE_URL": "http://localhost:8787",
    "ADMIN_BASE_URL": "http://localhost:5174",
    "PAGO_BASE_URL": "http://localhost:5175",
    /* landing-page D14: 5176 is the landing page's dev server; its script
       posts the request door with fetch. LANDING_BASE_URL stays unset here
       on purpose (D6): a plain form post answers the envelope until a
       developer sets it in .dev.vars. */
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176",
    /* Not a secret. Repeated in every env block below because an env's
       `vars` replaces the top-level one rather than merging with it. */
    "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>",
    /* cep-bundle-match D16: the one origin a bundle of CEPs is downloaded
       from — apiCEP's storage (measured 2026-09-26: public links, no
       token). A var, never a literal in code (constitution VIII); a link
       on any other origin is never fetched. `.dev.vars` points it at the
       sandbox (http://localhost:8789). Repeated below for the same
       reason as EMAIL_FROM. */
    "APICEP_STORAGE_ORIGIN": "https://storage.apicep.cloud"
  },
  /* Remote environments (CICD.md). Per-environment secrets set by CI
     after deploy: BETTER_AUTH_SECRET (required — auth cannot run without
     it), RESEND_API_KEY, APICEP_TOKEN (the validation engine's provider
     credential, consta-api-merge D9 — absent, the SPEI channel says it
     is unavailable). */
  "env": {
    "dev": {
      "name": "devolada-api-dev",
      "routes": [{ "pattern": "api.dev.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-dev",
          "database_id": "9928857f-af6c-4c59-a767-311b8de97df0",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs-dev" }
      ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "EXTRACTION_MODELS": [
          { "id": "@cf/mistralai/mistral-small-3.1-24b-instruct", "label": "Mistral Small 3.1" },
          /* receipt-reader-tuning D10: thinking off — the reader wants the
             JSON, not the reasoning (research R5) */
          { "id": "@cf/google/gemma-4-26b-a4b-it", "label": "Gemma 4 26B", "input": { "chat_template_kwargs": { "enable_thinking": false } } }
        ],
        "API_BASE_URL": "https://api.dev.devoladapago.com",
        "ADMIN_BASE_URL": "https://app.dev.devoladapago.com",
        "PAGO_BASE_URL": "https://link.dev.devoladapago.com",
        /* landing-page D14: the landing's host and its preview suffix, so
           the page's script can read the request door's answer */
        "ALLOWED_ORIGINS": "https://app.dev.devoladapago.com,https://link.dev.devoladapago.com,https://dev.devoladapago.com,*-devolada-admin-dev.devoladapago-14b.workers.dev,*-devolada-pago-dev.devoladapago-14b.workers.dev,*-devolada-landing-dev.devoladapago-14b.workers.dev",
        /* landing-page D6: the no-script form post lands on the landing's
           outcome pages */
        "LANDING_BASE_URL": "https://dev.devoladapago.com",
        "PASSKEY_RP_ID": "dev.devoladapago.com",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>",
        /* cep-bundle-match D16 */
        "APICEP_STORAGE_ORIGIN": "https://storage.apicep.cloud"
      }
    },
    "prod": {
      "name": "devolada-api",
      "routes": [{ "pattern": "api.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-prod",
          "database_id": "91a82e4a-f2ee-4fe7-a209-6109a17d1b78",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs" }
      ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "EXTRACTION_MODELS": [
          /* receipt-reader-tuning SC-005: prod stays on Mistral alone until the
             bench decides; a second model here is a deploy */
          { "id": "@cf/mistralai/mistral-small-3.1-24b-instruct", "label": "Mistral Small 3.1" }
        ],
        "API_BASE_URL": "https://api.devoladapago.com",
        "ADMIN_BASE_URL": "https://app.devoladapago.com",
        "PAGO_BASE_URL": "https://link.devoladapago.com",
        /* No APICEP_TOKEN planted here by this feature — switching
           production on is a separate decision (consta-api-merge, spec
           Q3); until it is, the channel is unavailable and says so. The
           engine deploys here all the same (D9): planting the secret is
           the whole act, with no code change. */
        "ALLOWED_ORIGINS": "https://app.devoladapago.com,https://link.devoladapago.com,https://devoladapago.com,https://www.devoladapago.com",
        "LANDING_BASE_URL": "https://devoladapago.com",
        "PASSKEY_RP_ID": "devoladapago.com",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>",
        /* cep-bundle-match D16 */
        "APICEP_STORAGE_ORIGIN": "https://storage.apicep.cloud"
      }
    }
  }
}
