{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devolada-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  /* Better Auth's bundle imports node:crypto. The spike ran without this
     flag, but only because vitest-pool-workers resolves node builtins
     itself; wrangler's own bundling does not. Inherited by every env. */
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devolada-db",
      "database_id": "devolada-db-local",
      "migrations_dir": "migrations"
    }
  ],
  /* SPEI transfer proofs (direct-payment spec D12). Private: no public
     bucket URL — the API serves objects through signed URLs only. The
     15-day lifecycle rule is bucket config, applied once per env:
     `wrangler r2 bucket lifecycle add <bucket> --name expire-15d --expire-days 15` */
  "r2_buckets": [
    { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs" }
  ],
  /* proof-extraction D5: the receipt reader runs on Workers AI. The model
     is a var, not a literal in code, so replacing it is a deploy and not
     a release. Like `d1_databases`, an env block replaces this rather
     than inheriting it, so both are repeated below (consta-api-merge D9). */
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "dev",
    "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "API_BASE_URL": "http://localhost:8787",
    "ADMIN_BASE_URL": "http://localhost:5174",
    "PAGO_BASE_URL": "http://localhost:5175",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175",
    /* Not a secret. Repeated in every env block below because an env's
       `vars` replaces the top-level one rather than merging with it. */
    "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
  },
  /* Remote environments (CICD.md). Per-environment secrets set by CI
     after deploy: BETTER_AUTH_SECRET (required — auth cannot run without
     it), RESEND_API_KEY, APICEP_TOKEN (the validation engine's provider
     credential, consta-api-merge D9 — absent, the SPEI channel says it
     is unavailable). */
  "env": {
    "dev": {
      "name": "devolada-api-dev",
      "routes": [{ "pattern": "api.dev.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-dev",
          "database_id": "9928857f-af6c-4c59-a767-311b8de97df0",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs-dev" }
      ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "API_BASE_URL": "https://api.dev.devoladapago.com",
        "ADMIN_BASE_URL": "https://app.dev.devoladapago.com",
        "PAGO_BASE_URL": "https://link.dev.devoladapago.com",
        "ALLOWED_ORIGINS": "https://app.dev.devoladapago.com,https://link.dev.devoladapago.com,*-devolada-admin-dev.devoladapago-14b.workers.dev,*-devolada-pago-dev.devoladapago-14b.workers.dev",
        "PASSKEY_RP_ID": "dev.devoladapago.com",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
      }
    },
    "prod": {
      "name": "devolada-api",
      "routes": [{ "pattern": "api.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-db-prod",
          "database_id": "91a82e4a-f2ee-4fe7-a209-6109a17d1b78",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROOFS", "bucket_name": "devolada-transfer-proofs" }
      ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "API_BASE_URL": "https://api.devoladapago.com",
        "ADMIN_BASE_URL": "https://app.devoladapago.com",
        "PAGO_BASE_URL": "https://link.devoladapago.com",
        /* No APICEP_TOKEN planted here by this feature — switching
           production on is a separate decision (consta-api-merge, spec
           Q3); until it is, the channel is unavailable and says so. The
           engine deploys here all the same (D9): planting the secret is
           the whole act, with no code change. */
        "ALLOWED_ORIGINS": "https://app.devoladapago.com,https://link.devoladapago.com",
        "PASSKEY_RP_ID": "devoladapago.com",
        "EMAIL_FROM": "Devolada <no-reply@devoladapago.com>"
      }
    }
  }
}
