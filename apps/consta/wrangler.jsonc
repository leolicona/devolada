{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devolada-consta",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devolada-consta-db",
      "database_id": "devolada-consta-db-local",
      "migrations_dir": "migrations"
    }
  ],
  /* proof-extraction D5: the reader runs on Workers AI. The model is a var,
     not a literal in code, so replacing it is a deploy and not a release. */
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "dev",
    "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct"
  },
  /* Secrets per env, set by CI after deploy (same TD-011 dance as the api):
     APICEP_TOKEN (provider), CONSTA_ADMIN_TOKEN (key issuance),
     CONSTA_ISSUER_TOKEN (issue-only door for the SaaS, payments-and-classes D7).
     Prod env block deliberately absent — it arrives with the first external
     consumer (validation spec D8). */
  "env": {
    "dev": {
      "name": "devolada-consta-dev",
      "routes": [{ "pattern": "consta.dev.devoladapago.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devolada-consta-db-dev",
          "database_id": "71e60c4f-3bbc-4d04-bfed-72d1a02353eb",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "vars": {
        "ENVIRONMENT": "dev",
        "EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct"
      }
    }
  }
}
