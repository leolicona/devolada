---
import { CheckCircle2, Landmark, MonitorSmartphone, Users } from "lucide-react";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";

/* /gracias (landing-page D6; FR-016): where a plain form post lands when
   the request was received. Says when the creator answers and asks for
   nothing further — no account, no code, no second form. What to have at
   hand is the first message's three questions (spec §The workflow the
   page starts, step 2). Not indexed: an outcome, not a page to find. */
const things = [
  { icon: Landmark, text: "Tu CLABE" },
  { icon: MonitorSmartphone, text: "El nombre de tu sistema de facturación" },
  { icon: Users, text: "Cuántos clientes tienes, más o menos" },
];
---

<Base title="Devolada — recibimos tu WhatsApp" description="Te escribimos por WhatsApp en menos de un día hábil.">
  <meta slot="head" name="robots" content="noindex" />
  <header slot="header" class="mx-auto flex w-full max-w-wide items-center gap-2.5 px-4 py-4">
    <Mark />
    <span class="text-md font-semibold tracking-tight">Devolada</span>
  </header>
  <section class="flex flex-col gap-4 py-10 lg:max-w-xl lg:py-14">
    <CheckCircle2 className="size-10 text-success" aria-hidden />
    <h1 class="text-2xl font-semibold leading-tight tracking-tight lg:text-3xl">
      ¡Listo! Te escribimos por <span class="text-link">WhatsApp.</span>
    </h1>
    <p class="text-md text-ink-soft">En menos de un día hábil. Tú no tienes que hacer nada más.</p>
    <div class="mt-2 flex flex-col gap-3 rounded-lg border border-accent bg-accent-soft p-6">
      <h2 class="text-md font-semibold leading-tight">Mientras tanto, ten a la mano:</h2>
      <ul class="flex flex-col gap-2.5">
        {
          things.map(({ icon: Icon, text }) => (
            <li class="flex items-center gap-2 text-sm font-medium">
              <Icon className="size-4 shrink-0 text-link" aria-hidden />
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <a href="/" class="inline-flex min-h-12 items-center self-start font-medium text-link hover:underline">Volver a la página</a>
  </section>
</Base>
